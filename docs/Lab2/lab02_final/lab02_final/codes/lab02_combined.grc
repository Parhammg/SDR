- name: recorder
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nSDR Lab I/Q recorder -- source code for a GNU Radio Companion\
      \ \"Python Block\".\n\nWrites raw complex-float32 (cf32) I/Q files named by\
      \ the lab rule\n    teamID_labNN_fc_fs_gain_timestamp.cf32\ne.g. Team-07_lab01_98000000_2048000_40.2_20261005T101502.cf32\n\
      \n* A new file is opened each time `record` changes from False to True.\n* Recording\
      \ stops when `record` returns to False or after `max_seconds`.\n* If fc, fs\
      \ or gain change while recording, the file is closed, so one\n  file never mixes\
      \ two settings (untick / tick `record` for a new take).\n\"\"\"\nimport os\n\
      import time\n\nimport numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self, team='Team-00', lab=1, fc=100e6, fs=2.048e6, gain=0.0,\n\
      \                 record=False, max_seconds=5.0, folder='.'):\n        gr.sync_block.__init__(self,\
      \ name='SDR Lab IQ Recorder',\n                               in_sig=[np.complex64],\
      \ out_sig=None)\n        # Attributes named like the arguments can be changed\
      \ at run time\n        # from GRC variables (QT GUI Range, QT GUI Check Box,\
      \ ...).\n        self.team, self.lab = team, lab\n        self.fc, self.fs,\
      \ self.gain = fc, fs, gain\n        self.record, self.max_seconds, self.folder\
      \ = record, max_seconds, folder\n        self._fh = None       # open file (None\
      \ = not recording)\n        self._n = 0           # samples written to the current\
      \ file\n        self._key = None      # (fc, fs, gain) when the file was opened\n\
      \        self._armed = True    # False after a take until `record` is released\n\
      \n    def _open(self):\n        stamp = time.strftime('%Y%m%dT%H%M%S')\n   \
      \     name = '%s_lab%02d_%d_%d_%.1f_%s.cf32' % (\n            self.team, int(self.lab),\
      \ round(self.fc), round(self.fs),\n            self.gain, stamp)\n        os.makedirs(self.folder,\
      \ exist_ok=True)\n        self._fh = open(os.path.join(self.folder, name), 'wb')\n\
      \        self._n, self._key = 0, (self.fc, self.fs, self.gain)\n        print('[REC]\
      \ start ' + name)\n\n    def _close(self, why):\n        self._fh.close()\n\
      \        self._fh, self._armed = None, False\n        print('[REC] stop  %d\
      \ samples = %.2f s (%s)'\n              % (self._n, self._n / self.fs, why))\n\
      \n    def work(self, input_items, output_items):\n        x = input_items[0]\n\
      \        if not self.record:\n            if self._fh is not None:\n       \
      \         self._close('record off')\n            self._armed = True\n      \
      \  elif self._fh is None and self._armed:\n            self._open()\n      \
      \  if self._fh is not None:\n            if (self.fc, self.fs, self.gain) !=\
      \ self._key:\n                self._close('fc/fs/gain changed')\n          \
      \  else:\n                left = int(self.max_seconds * self.fs) - self._n\n\
      \                n = min(len(x), left)\n                x[:n].tofile(self._fh)\n\
      \                self._n += n\n                if n == left:\n             \
      \       self._close('max_seconds reached')\n        return len(x)\n\n    def\
      \ stop(self):\n        if self._fh is not None:\n            self._close('flowgraph\
      \ stopped')\n        return True\n"
    affinity: ''
    alias: ''
    comment: ''
    fc: f_c
    folder: '''.'''
    fs: samp_rate
    gain: rf_gain
    lab: '8'
    max_seconds: '5.0'
    maxoutbuf: '0'
    minoutbuf: '0'
    record: rec
    team: team
  states:
    _io_cache: ('SDR Lab IQ Recorder', 'blk', [('team', "'Team-00'"), ('lab', '1'),
      ('fc', '100000000.0'), ('fs', '2048000.0'), ('gain', '0.0'), ('record', 'False'),
      ('max_seconds', '5.0'), ('folder', "'.'")], [('0', 'complex', 1)], [], '', ['fc',
      'folder', 'fs', 'gain', 'lab', 'max_seconds', 'record', 'team'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 908.0]
    rotation: 0
    state: enabled

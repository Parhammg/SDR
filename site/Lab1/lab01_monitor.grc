- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import os\nimport datetime\nimport numpy as np\nfrom gnuradio import\
      \ gr\n\n\nclass blk(gr.sync_block):\n    \"\"\"\n    SDR Lab IQ Recorder\n \
      \   \u0636\u0628\u0637 \u062F\u0627\u062F\u0647 \u062E\u0627\u0645 I/Q \u0628\
      \u0627 \u0641\u0631\u0645\u062A \u0627\u0633\u062A\u0627\u0646\u062F\u0627\u0631\
      \u062F \u0622\u0632\u0645\u0627\u06CC\u0634\u06AF\u0627\u0647:\n    teamID_labNN_fc_fs_gain_timestamp.cf32\n\
      \    \"\"\"\n\n    def __init__(\n        self,\n        team_id=\"Team-07\"\
      ,\n        lab_id=\"lab01\",\n        fc=945000000,\n        fs=2600000,\n \
      \       gain=20.0,\n        record=False,\n        max_seconds=3.8,\n      \
      \  out_dir=\".\",\n    ):\n        gr.sync_block.__init__(\n            self,\n\
      \            name=\"SDR Lab IQ Recorder\",\n            in_sig=[np.complex64],\n\
      \            out_sig=None,\n        )\n\n        # \u0630\u062E\u06CC\u0631\u0647\
      \ \u067E\u0627\u0631\u0627\u0645\u062A\u0631\u0647\u0627\u06CC \u0627\u0648\u0644\
      \u06CC\u0647\n        self._team_id = str(team_id)\n        self._lab_id = str(lab_id)\n\
      \        self._fc = fc\n        self._fs = fs\n        self._gain = gain\n \
      \       self._record = bool(record)\n        self._max_seconds = float(max_seconds)\n\
      \        self._out_dir = str(out_dir)\n\n        # \u0645\u062A\u063A\u06CC\u0631\
      \u0647\u0627\u06CC \u0648\u0636\u0639\u06CC\u062A \u0636\u0628\u0637\n     \
      \   self._file = None\n        self._filename = \"\"\n        self._samples_written\
      \ = 0\n        self._max_samples = 0\n        self._locked_until_uncheck = False\n\
      \n    def _open_new_file(self):\n        \"\"\"\u0628\u0627\u0632 \u06A9\u0631\
      \u062F\u0646 \u06CC\u06A9 \u0641\u0627\u06CC\u0644 \u062C\u062F\u06CC\u062F\
      \ \u0628\u0627 \u0646\u0627\u0645 \u0627\u0633\u062A\u0627\u0646\u062F\u0627\
      \u0631\u062F \u0622\u0632\u0645\u0627\u06CC\u0634\u06AF\u0627\u0647\"\"\"\n\
      \        if not os.path.exists(self._out_dir):\n            os.makedirs(self._out_dir,\
      \ exist_ok=True)\n\n        timestamp = datetime.datetime.now().strftime(\"\
      %Y%m%dT%H%M%S\")\n        fname = f\"{self._team_id}_{self._lab_id}_{int(self._fc)}_{int(self._fs)}_{float(self._gain):.1f}_{timestamp}.cf32\"\
      \n        self._filename = os.path.join(self._out_dir, fname)\n\n        self._file\
      \ = open(self._filename, \"wb\")\n        self._samples_written = 0\n      \
      \  self._max_samples = int(round(self._max_seconds * self._fs))\n\n        print(\n\
      \            f\"[REC] Started recording: {self._filename} (Max limit: {self._max_seconds:.2f}\
      \ s)\"\n        )\n\n    def _close_file(self, reason=\"\"):\n        \"\"\"\
      \u0628\u0633\u062A\u0646 \u0641\u0627\u06CC\u0644 \u0641\u0639\u0644\u06CC \u0648\
      \ \u0686\u0627\u067E \u06AF\u0632\u0627\u0631\u0634 \u062F\u0631 \u06A9\u0646\
      \u0633\u0648\u0644\"\"\"\n        if self._file is not None:\n            self._file.close()\n\
      \            self._file = None\n            duration = (\n                self._samples_written\
      \ / float(self._fs) if self._fs > 0 else 0.0\n            )\n            size_mb\
      \ = (self._samples_written * 8) / (1024 * 1024)\n            msg = f\" | Reason:\
      \ {reason}\" if reason else \"\"\n            print(\n                f\"[REC]\
      \ Closed file: {self._filename} | Duration: {duration:.2f} s ({size_mb:.2f}\
      \ MB){msg}\"\n            )\n\n    # --- \u0645\u062A\u062F\u0647\u0627\u06CC\
      \ \u0627\u0631\u062A\u0628\u0627\u0637 \u0628\u0627 \u0645\u062A\u063A\u06CC\
      \u0631\u0647\u0627\u06CC GRC (Callback Setters) ---\n\n    @property\n    def\
      \ team_id(self):\n        return self._team_id\n\n    @team_id.setter\n    def\
      \ team_id(self, val):\n        self._team_id = str(val)\n\n    @property\n \
      \   def lab_id(self):\n        return self._lab_id\n\n    @lab_id.setter\n \
      \   def lab_id(self, val):\n        self._lab_id = str(val)\n\n    @property\n\
      \    def fc(self):\n        return self._fc\n\n    @fc.setter\n    def fc(self,\
      \ val):\n        if self._fc != val:\n            self._fc = val\n         \
      \   if self._file is not None:\n                self._close_file(\n        \
      \            \"Center frequency (fc) changed during recording\"\n          \
      \      )\n                self._locked_until_uncheck = True\n\n    @property\n\
      \    def fs(self):\n        return self._fs\n\n    @fs.setter\n    def fs(self,\
      \ val):\n        if self._fs != val:\n            if self._file is not None:\n\
      \                self._close_file(\"Sample rate (fs) changed during recording\"\
      )\n                self._locked_until_uncheck = True\n            self._fs =\
      \ val\n\n    @property\n    def gain(self):\n        return self._gain\n\n \
      \   @gain.setter\n    def gain(self, val):\n        if self._gain != val:\n\
      \            self._gain = val\n            if self._file is not None:\n    \
      \            self._close_file(\"Gain changed during recording\")\n         \
      \       self._locked_until_uncheck = True\n\n    @property\n    def record(self):\n\
      \        return self._record\n\n    @record.setter\n    def record(self, val):\n\
      \        val_bool = bool(val)\n        if not val_bool:\n            # \u0648\
      \u0642\u062A\u06CC \u06A9\u0627\u0631\u0628\u0631 \u062A\u06CC\u06A9 Record\
      \ \u0631\u0627 \u0628\u0631\u0645\u06CC\u200C\u062F\u0627\u0631\u062F\n    \
      \        if self._file is not None:\n                self._close_file(\"User\
      \ unchecked Record I/Q\")\n            self._locked_until_uncheck = False\n\
      \        self._record = val_bool\n\n    @property\n    def max_seconds(self):\n\
      \        return self._max_seconds\n\n    @max_seconds.setter\n    def max_seconds(self,\
      \ val):\n        self._max_seconds = float(val)\n        if self._file is not\
      \ None:\n            self._max_samples = int(round(self._max_seconds * self._fs))\n\
      \n    @property\n    def out_dir(self):\n        return self._out_dir\n\n  \
      \  @out_dir.setter\n    def out_dir(self, val):\n        self._out_dir = str(val)\n\
      \n    # --- \u062D\u0644\u0642\u0647 \u0627\u0635\u0644\u06CC \u067E\u0631\u062F\
      \u0627\u0632\u0634 \u0646\u0645\u0648\u0646\u0647\u200C\u0647\u0627 ---\n\n\
      \    def work(self, input_items, output_items):\n        in0 = input_items[0]\n\
      \        n_in = len(in0)\n\n        if self._record and not self._locked_until_uncheck:\n\
      \            # \u0627\u06AF\u0631 \u062A\u0627\u0632\u0647 \u062A\u06CC\u06A9\
      \ \u0632\u062F\u0647 \u0634\u062F\u0647\u060C \u0641\u0627\u06CC\u0644 \u062C\
      \u062F\u06CC\u062F \u0628\u0627\u0632 \u06A9\u0646\n            if self._file\
      \ is None:\n                self._open_new_file()\n\n            # \u0628\u0631\
      \u0631\u0633\u06CC \u0633\u0642\u0641 \u0645\u062C\u0627\u0632 \u0646\u0645\u0648\
      \u0646\u0647\u200C\u0647\u0627 \u0637\u0628\u0642 rec_sec\n            remaining\
      \ = self._max_samples - self._samples_written\n            if remaining <= 0:\n\
      \                self._close_file(f\"Reached max duration ({self._max_seconds}s)\"\
      )\n                self._locked_until_uncheck = True\n            else:\n  \
      \              to_write = min(n_in, remaining)\n                # \u0630\u062E\
      \u06CC\u0631\u0647 \u0628\u0627 \u0641\u0631\u0645\u062A \u0627\u0633\u062A\u0627\
      \u0646\u062F\u0627\u0631\u062F cf32 (8 \u0628\u0627\u06CC\u062A \u0628\u0647\
      \ \u0627\u0632\u0627\u06CC \u0647\u0631 \u0646\u0645\u0648\u0646\u0647: 4 \u0628\
      \u0627\u06CC\u062A I \u0648 4 \u0628\u0627\u06CC\u062A Q)\n                in0[:to_write].tofile(self._file)\n\
      \                self._samples_written += to_write\n\n                if self._samples_written\
      \ >= self._max_samples:\n                    self._close_file(\n           \
      \             f\"Reached max duration ({self._max_seconds}s)\"\n           \
      \         )\n                    self._locked_until_uncheck = True\n\n     \
      \   return n_in\n\n    def stop(self):\n        \"\"\"\u0628\u0633\u062A\u0646\
      \ \u0627\u06CC\u0645\u0646 \u0641\u0627\u06CC\u0644 \u062F\u0631 \u0635\u0648\
      \u0631\u062A \u062A\u0648\u0642\u0641 \u0641\u0644\u0648\u06AF\u0631\u0627\u0641\
      \"\"\"\n        if self._file is not None:\n            self._close_file(\"\
      Flowgraph stopped\")\n        return True"
    affinity: ''
    alias: ''
    comment: ''
    fc: f_tune
    fs: samp_rate
    gain: rf_gain
    lab_id: '"lab01"'
    max_seconds: rec_sec
    maxoutbuf: '0'
    minoutbuf: '0'
    out_dir: '"."'
    record: rec
    team_id: '"Team_01"'
  states:
    _io_cache: "('SDR Lab IQ Recorder', 'blk', [('team_id', \"'Team-07'\"), ('lab_id',\
      \ \"'lab01'\"), ('fc', '945000000'), ('fs', '2600000'), ('gain', '20.0'), ('record',\
      \ 'False'), ('max_seconds', '3.8'), ('out_dir', \"'.'\")], [('0', 'complex',\
      \ 1)], [], '\\n    SDR Lab IQ Recorder\\n    \u0636\u0628\u0637 \u062F\u0627\
      \u062F\u0647 \u062E\u0627\u0645 I/Q \u0628\u0627 \u0641\u0631\u0645\u062A \u0627\
      \u0633\u062A\u0627\u0646\u062F\u0627\u0631\u062F \u0622\u0632\u0645\u0627\u06CC\
      \u0634\u06AF\u0627\u0647:\\n    teamID_labNN_fc_fs_gain_timestamp.cf32\\n  \
      \  ', ['fc', 'fs', 'gain', 'lab_id', 'max_seconds', 'out_dir', 'record', 'team_id'])"
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [536, 476.0]
    rotation: 0
    state: enabled
